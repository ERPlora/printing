{
  "id": "printing",
  "name": "Printing",
  "description": "Receipt, kitchen and label printing from the device you have connected.",
  "icon": "print",
  "version": "0.1.14",
  "agent": {
    "description": "Configures printing: ticket header/footer, paper width, auto-print on sale, and routing of order items to kitchen/bar stations. Actual printing and the cash drawer are driven by the device registered as a print host, which drains the hub's queue over the runtime WebSocket (ADR-0196).",
    "keywords": [
      "print",
      "printer",
      "receipt",
      "ticket",
      "kitchen",
      "label",
      "cash drawer",
      "escpos",
      "bridge"
    ]
  },
  "depends_on": [],
  "capabilities": {
    "printer": {}
  },
  "permissions": [
    "printing.view_settings",
    "printing.manage_settings",
    "printing.print",
    "printing.open_drawer"
  ],
  "role_permissions": {
    "admin": [
      "*"
    ],
    "manager": [
      "printing.view_settings",
      "printing.manage_settings",
      "printing.print",
      "printing.open_drawer"
    ],
    "employee": [
      "printing.view_settings",
      "printing.print",
      "printing.open_drawer"
    ]
  },
  "navigation": [
    {
      "id": "printing",
      "label": "Printers",
      "icon": "print",
      "component": "erp-printing-settings"
    }
  ],
  "setup": {
    "query": "printing.settings.get",
    "configured_when": [
      {
        "field": "receipt_header",
        "truthy": true
      }
    ],
    "title": "Your printer",
    "description": "Put your business details on the receipt and assign the printer that prints it.",
    "icon": "print-outline",
    "route": "/m/printing/printing",
    "permission": "printing.manage_settings",
    "countries": [],
    "order": 70,
    "required": false
  },
  "migrations": {
    "postgres": [
      "migrations/postgres/001_init.sql",
      "migrations/postgres/002_jobs.sql"
    ]
  },
  "queries": {
    "printing.settings.get": {
      "permission": "printing.view_settings",
      "sql": "queries/settings_get.sql",
      "ai": {
        "description": "Retrieves the printing settings (receipt header/footer, paper width, auto-print and auto-open-drawer on sale)"
      }
    }
  },
  "commands": {
    "printing.settings.update": {
      "permission": "printing.manage_settings",
      "transaction": true,
      "schema": "schemas/settings_update.json",
      "sql": [
        "commands/settings_upsert.sql"
      ],
      "ai": {
        "description": "Updates the printing settings (header/footer/paper width/auto-print/auto-open-drawer)"
      }
    },
    "printing.jobs.create": {
      "permission": "printing.print",
      "transaction": true,
      "schema": "schemas/jobs_create.json",
      "sql": [
        "commands/jobs_create.sql"
      ],
      "emit": [
        "printing.print.due"
      ],
      "ai": {
        "description": "Sends a document (receipt, kitchen order, label…) to the hub's print queue; jobId dedups repeated requests"
      }
    }
  },
  "events": {
    "emits": [
      "printing.print.due"
    ]
  },
  "ui": {
    "entry": "dist/printing.esm.js"
  }
}
